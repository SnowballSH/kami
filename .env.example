# Kami's environment, one line per setting. Copy to `.env` (gitignored) and fill in what you use;
# everything is optional. docs/hosting.md has the full table, server/README.md the details.
# Any secret (`*_API_KEY`, `MONGODB_URI`, `KAMI_CREDENTIALS`) may instead be read from a file
# named by the same variable with `_FILE` appended, e.g. `KAMI_LLM_API_KEY_FILE=/run/secrets/llm`.

# --- Models -------------------------------------------------------------------------------------
# Any OpenAI-compatible chat endpoint (OpenAI, OpenRouter, vLLM, Ollama, a gateway) for the laws
# the offline grammar cannot read. Unset: the grammar alone.
KAMI_LLM_URL=
KAMI_LLM_MODEL=
KAMI_LLM_API_KEY=
KAMI_LLM_REASONING_EFFORT=
# A vision-capable model that reads handwriting; defaults to the LLM settings above.
KAMI_TRANSCRIBE_URL=
KAMI_TRANSCRIBE_MODEL=
KAMI_TRANSCRIBE_API_KEY=
# Kami's Eye sidecar (ml/CONTRACT.md). With `--profile eye`: http://eye:8790
KAMI_RECOGNIZER_URL=
KAMI_RECOGNIZER_API_KEY=
# The Eye's exemplar set (drawings summoned by name) and the artefact directory the eye service mounts.
KAMI_SKETCHES=
KAMI_EYE_ARTIFACTS=./ml/artifacts/kami-eye
# The sketch beautifier, if one is attached.
KAMI_BEAUTIFY_URL=
KAMI_BEAUTIFY_API_KEY=
# Model spending guards.
KAMI_MODEL_REQUESTS_PER_MINUTE=
KAMI_MODEL_CONCURRENCY=

# --- Storage ------------------------------------------------------------------------------------
# Unset: an embedded mongod keeps its data in KAMI_DATA_DIR (/data in the image, the kami-data volume).
# With `--profile mongo`: mongodb://mongo:27017
MONGODB_URI=
KAMI_MONGO_CACHE_GB=0.25
# The Quick, Draw! corpus (a read-only .ndjson.gz from `bun run quickdraw:ingest`); the image bakes one
# in. Uncomment only to use your own; an empty value here would hide the baked one.
# KAMI_QUICKDRAW_SNAPSHOT=/srv/kami/quickdraw.ndjson.gz

# --- Access (docs/access.md) --------------------------------------------------------------------
# `demo` trusts every peer on the network; `shared` for anything reachable from the internet.
KAMI_ACCESS_MODE=demo
# Exact public origins, comma-separated, e.g. https://kami.example.org
KAMI_ALLOWED_ORIGINS=
# Shared mode: a JSON array of credentials; prefer KAMI_CREDENTIALS_FILE.
KAMI_CREDENTIALS=
# Where compose publishes the game on the host (127.0.0.1:8080 keeps it behind a reverse proxy).
KAMI_PUBLISH=8080

# --- Performance --------------------------------------------------------------------------------
# ONNX Runtime threads for the eye service; 1 on a shared host.
KAMI_EYE_THREADS=1
# Bun flags for the game server. --smol made no measurable difference to Kami's idle memory.
BUN_OPTIONS=
