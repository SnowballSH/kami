{
  "name": "kami",
  "description": "A hand-drawn puzzle-platformer: what you draw becomes solid ink, and becomes whatever you say it is.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SnowballSH/kami.git"
  },
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "concurrently -k -n web,server -c blue,green \"vite\" \"bun run server\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "tsc --noEmit && biome check . && vitest run",
    "check:lightweight": "bash scripts/ci/lightweight.sh",
    "dev:web": "vite --host",
    "server": "bun --watch server/index.ts",
    "quickdraw:ingest": "bun server/quickdraw/ingest.ts",
    "font:build": "bun scripts/buildStrokeFont.ts",
    "brand:build": "bun src/brand/build.ts"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "mongodb": "^7.6.0",
    "mongodb-memory-server": "^11.2.0",
    "perfect-freehand": "^1.2.3",
    "qrcode": "1.5.4",
    "roughjs": "^4.6.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.4.2",
    "@types/matter-js": "^0.20.2",
    "@types/qrcode": "1.5.5",
    "concurrently": "^10.0.5",
    "gifenc": "1.0.3",
    "happy-dom": "^20.14.5",
    "hersheytext": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
